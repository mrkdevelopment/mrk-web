---
/**
 * Everything search engines, social apps and AI assistants read in <head>: title, description,
 * canonical, robots, Open Graph, Twitter/X card and one JSON-LD @graph.
 *
 * Put it inside <head> in the layout, after <meta charset> and <meta name="viewport">:
 *   <SeoHead title="Roof repairs" description="..." breadcrumbs={[{ name: 'Services', path: '/services/' }]} />
 *
 * Structured data: one @graph with stable @ids, so nodes reference each other instead of repeating:
 *   {site}/#organization   the business (Organization or LocalBusiness, from src/data/site.ts)
 *   {site}/#website        the website
 *   {page}#webpage         this page
 *   {page}#breadcrumb      when `breadcrumbs` is given
 * A page adds its own nodes with `schema` (e.g. a Service or Article that points at
 * { '@id': `${site}/#organization` }). Deliberately NOT added by default: FAQPage, HowTo and
 * reviews/ratings of the business itself. Google limits or ignores those for most sites and
 * self-written reviews break its guidelines; add one only when the page truly qualifies.
 */
import { absoluteUrl, site } from '../data/site';

interface Breadcrumb {
  name: string;
  path: string;
}

interface Props {
  /** The page's own title, without the business name: the suffix is added when it fits */
  title: string;
  /** 140-160 characters, written for a person deciding whether to click */
  description?: string;
  /** Share image path in public/ or absolute URL (1200x630); defaults to site.ogImage */
  image?: string;
  imageAlt?: string;
  /** Open Graph type; "article" also outputs the article dates */
  type?: 'website' | 'article';
  /** schema.org type of this page: WebPage, AboutPage, ContactPage, CollectionPage, ... */
  pageType?: string;
  /** Keep this page out of search results and the sitemap (thank-you pages, internal pages) */
  noindex?: boolean;
  /** Only when this page is a duplicate of another URL; defaults to this page's own URL */
  canonical?: string;
  /** ISO dates, only when actually known. dateModified also becomes the sitemap's <lastmod>. */
  published?: string;
  modified?: string;
  /** Trail after Home, ending with this page */
  breadcrumbs?: Breadcrumb[];
  /** Extra JSON-LD nodes for this page, added to the same @graph */
  schema?: Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  image = site.ogImage,
  imageAlt,
  type = 'website',
  pageType = 'WebPage',
  noindex = false,
  canonical: canonicalOverride,
  published,
  modified,
  breadcrumbs,
  schema = [],
} = Astro.props;

const base = Astro.site?.href ?? site.url;
const origin = new URL(base).origin;
const canonical = absoluteUrl(canonicalOverride ?? Astro.url.pathname, base);
const imageUrl = image ? absoluteUrl(image, base) : '';

// Google shows about 60 characters; add " | Name" only when the result still fits
const suffixed = `${title} | ${site.name}`;
const fullTitle = title === site.name || suffixed.length > 60 ? title : suffixed;

const ogLocale = site.locale.replace('-', '_');

// Empty values from site.ts are left out rather than published blank
const address = Object.values(site.address).some(Boolean)
  ? {
      '@type': 'PostalAddress',
      ...(site.address.street && { streetAddress: site.address.street }),
      ...(site.address.locality && { addressLocality: site.address.locality }),
      ...(site.address.region && { addressRegion: site.address.region }),
      ...(site.address.postcode && { postalCode: site.address.postcode }),
      ...(site.address.country && { addressCountry: site.address.country }),
    }
  : undefined;

const ids = {
  organization: `${origin}/#organization`,
  website: `${origin}/#website`,
  webpage: `${canonical}#webpage`,
  breadcrumb: `${canonical}#breadcrumb`,
};

const graph: Record<string, unknown>[] = [
  {
    '@type': site.schemaType,
    '@id': ids.organization,
    name: site.name,
    ...(site.legalName && { legalName: site.legalName }),
    url: `${origin}/`,
    description: site.description,
    ...(site.logo && { logo: { '@type': 'ImageObject', url: absoluteUrl(site.logo, base) } }),
    // LocalBusiness types expect an image; the logo is the safe default
    ...(site.logo && site.schemaType !== 'Organization' && { image: absoluteUrl(site.logo, base) }),
    ...(site.email && { email: site.email }),
    ...(site.phone && { telephone: site.phone }),
    ...(address && { address }),
    ...(site.social.length && { sameAs: site.social }),
  },
  {
    '@type': 'WebSite',
    '@id': ids.website,
    url: `${origin}/`,
    name: site.name,
    inLanguage: site.locale,
    publisher: { '@id': ids.organization },
  },
  {
    '@type': pageType,
    '@id': ids.webpage,
    url: canonical,
    name: title,
    description,
    inLanguage: site.locale,
    isPartOf: { '@id': ids.website },
    about: { '@id': ids.organization },
    ...(imageUrl && { primaryImageOfPage: { '@type': 'ImageObject', url: imageUrl } }),
    ...(published && { datePublished: published }),
    ...(modified && { dateModified: modified }),
    ...(breadcrumbs?.length && { breadcrumb: { '@id': ids.breadcrumb } }),
  },
  ...(breadcrumbs?.length
    ? [
        {
          '@type': 'BreadcrumbList',
          '@id': ids.breadcrumb,
          itemListElement: [{ name: 'Home', path: '/' }, ...breadcrumbs].map((crumb, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: crumb.name,
            item: absoluteUrl(crumb.path, base),
          })),
        },
      ]
    : []),
  ...schema,
];

// "<" escaped so text in the data can never close the <script> tag early
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{imageUrl && <meta property="og:image" content={imageUrl} />}
{imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
{type === 'article' && published && <meta property="article:published_time" content={published} />}
{type === 'article' && modified && <meta property="article:modified_time" content={modified} />}

<meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
{site.xHandle && <meta name="twitter:site" content={site.xHandle} />}
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
{imageUrl && <meta name="twitter:image" content={imageUrl} />}

<link rel="sitemap" type="application/xml" href="/sitemap.xml" />
<link rel="alternate" type="text/markdown" title="llms.txt" href="/llms.txt" />

<script type="application/ld+json" is:inline set:html={jsonLd} />
