# Build-time settings, read by Astro during `npm run build`.
# Locally: copy to .env (never committed). On Cloudflare: Pages project > Settings > Variables and Secrets,
# for BOTH Production and Preview. Only PUBLIC_ values end up in the browser, so never put a secret in one.

# Node version Cloudflare builds with (check the minimum in package.json "engines")
NODE_VERSION="22"
# Optional: overrides `url` in src/data/site.ts, e.g. for a staging copy. Leave empty for production.
SITE_URL=""
# Optional: Cloudflare Turnstile SITE key (public). Pair it with TURNSTILE_SECRET_KEY in .dev.vars / runtime.
PUBLIC_TURNSTILE_SITE_KEY=""
# Optional: Google Analytics 4 measurement ID (G-...). When set, the cookie banner appears and GA loads only after Accept.
PUBLIC_GA_ID=""
# Optional: Google Tag Manager container ID (GTM-...). Use this OR PUBLIC_GA_ID, not both.
PUBLIC_GTM_ID=""
